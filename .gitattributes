# Auto detect text files and perform LF normalization

* text=auto

# .Net files

*.cs     text diff=csharp
*.csproj text eol=crlf
*.slnx   text eol=crlf

# Cmake

*.cmake text eol=lf

# Documents

*.md text diff=markdown linguist-detectable

# Github files

codeowners text

# Graphics

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary

# Bash

*.sh text eol=lf

# Serialisation

*.json text
*.xml  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Verify snapshot files
*.verified.txt text  eol=lf
*.verified.cs  text  eol=lf
*.received.txt text  eol=lf
*.received.cs  text  eol=lf

# Exclude files form exporting

.gitattributes export-ignore
.gitignore     export-ignore
