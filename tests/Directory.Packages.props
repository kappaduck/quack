<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <ItemGroup Label="Test packages">
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.11" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="TUnit" Version="1.65.38" IncludeAssets="$(IncludedAssets)" PrivateAssets="all" />
    <PackageVersion Include="TUnit.Mocks" Version="1.65.38" IncludeAssets="$(IncludedAssets)" PrivateAssets="all" />
    <PackageVersion Include="TUnit.Mocks.Assertions" Version="1.65.38" IncludeAssets="$(IncludedAssets)" PrivateAssets="all" />
    <PackageVersion Include="TUnit.Assertions.Should" Version="1.65.38-beta" IncludeAssets="$(IncludedAssets)" PrivateAssets="all" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.28.0" />
  </ItemGroup>
</Project>
