<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <ItemGroup Label="Common packages">
    <PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" PrivateAssets="all" IncludeAssets="$(IncludedAssets)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="KappaDuck.Quack.Runtimes" Version="0.1.0-beta.*" />
  </ItemGroup>

</Project>
